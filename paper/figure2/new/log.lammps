
units           metal
atom_style      atomic
boundary        p p p
newton          on

variable        a0           equal 3.59
variable        nrep         equal 10
variable        seed         equal 12345
variable        delta        equal 0.005
variable        etol         equal 1.0e-12
variable        ftol         equal 1.0e-8
variable        maxiter      equal 10000
variable        maxeval      equal 100000

# ------------ SYSTEM / STRUCTURE ------------
lattice         fcc ${a0}
lattice         fcc 3.59
Lattice spacing in x,y,z = 3.59 3.59 3.59
region          box block 0 ${nrep} 0 ${nrep} 0 ${nrep}
region          box block 0 10 0 ${nrep} 0 ${nrep}
region          box block 0 10 0 10 0 ${nrep}
region          box block 0 10 0 10 0 10
create_box      5 box
Created orthogonal box = (0 0 0) to (35.9 35.9 35.9)
  2 by 2 by 2 MPI processor grid
create_atoms    1 box
Created 4000 atoms
  using lattice units in orthogonal box = (0 0 0) to (35.9 35.9 35.9)
  create_atoms CPU = 0.000 seconds

# Random, approximately equiatomic assignment across 5 types (1..5)
variable seed3 equal v_seed+1
variable seed4 equal v_seed+2
variable seed5 equal v_seed+3
set type 1 type/fraction 2 0.20 ${seed}
set type 1 type/fraction 2 0.20 12345
Setting atom values ...
  772 settings made for type/fraction
set type 1 type/fraction 3 0.25 ${seed3}
set type 1 type/fraction 3 0.25 12346
Setting atom values ...
  835 settings made for type/fraction
set type 1 type/fraction 4 $(1.0/3.0) ${seed4}
set type 1 type/fraction 4 0.33333333333333331483 ${seed4}
set type 1 type/fraction 4 0.33333333333333331483 12347
Setting atom values ...
  789 settings made for type/fraction
set type 1 type/fraction 5 0.5 ${seed5}
set type 1 type/fraction 5 0.5 12348
Setting atom values ...
  809 settings made for type/fraction

# Masses (1=Co, 2=Ni, 3=Cr, 4=Fe, 5=Mn)
mass 1 58.933
mass 2 58.69
mass 3 51.96
mass 4 55.847
mass 5 54.94

# ---------- INTERATOMIC POTENTIAL ----------
pair_style meam
pair_coeff * * ./library.meam Co Ni Cr Fe Mn ./CoNiCrFeMn.meam Co Ni Cr Fe Mn

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# ------------ MINIMIZATION TO ~0 K AND 0 PRESSURE ------------
reset_timestep  0
thermo          100
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy pxz pyz

# Relax both atomic positions and box to ~0 pressure
fix             relax all box/relax aniso 0.0
min_style       cg
min_modify      dmax 0.1 line quadratic
minimize        ${etol} ${ftol} ${maxiter} ${maxeval}
minimize        1e-12 ${ftol} ${maxiter} ${maxeval}
minimize        1e-12 1e-08 ${maxiter} ${maxeval}
minimize        1e-12 1e-08 10000 ${maxeval}
minimize        1e-12 1e-08 10000 100000
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 6.5
  ghost atom cutoff = 6.5
  binsize = 3.25, bins = 12 12 12
  2 neighbor lists, perpetual/occasional/extra = 2 0 0
  (1) pair meam, perpetual
      attributes: full, newton on
      pair build: full/bin/atomonly
      stencil: full/bin/3d
      bin: standard
  (2) pair meam, perpetual, half/full from (1)
      attributes: half, newton on
      pair build: halffull/newton
      stencil: none
      bin: none
