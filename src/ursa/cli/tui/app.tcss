Screen {
    layout: vertical;
    background: $background;
}

HotlistScreen,
ThemeScreen {
    align: center bottom;
    background: transparent;
}

#hotlist {
    width: 100%;
    height: 65%;
    min-height: 10;
    max-height: 16;
    margin-bottom: 4;
    padding: 0 1 1 1;
    border: round $accent;
    background: $surface;
}

#hotlist-header {
    width: 100%;
    height: 1;
}

#hotlist-title,
ModelScreen .model-yaml-error,
.model-field-label,
.hierarchy-message-route,
.tool-call-preview,
.agent-tool-preview,
.edit-title,
#welcome-logo,
#welcome-config,
#welcome-workspace-row.workspace-inline > #welcome-workspace,
.coordination-page,
.tool-json-pane,
.command-compact-text,
.tool-message-body,
.activity-text {
    width: 1fr;
}

#hotlist-exit-hint {
    width: auto;
}

#hotlist-query {
    margin-bottom: 0;
}

#hotlist-options {
    height: 1fr;
    min-height: 3;
}

InformationScreen,
MessagesScreen,
ModelScreen {
    align: center middle;
    background: $background 50%;
}

.settings-dialog {
    width: 70;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

ModelScreen .settings-dialog {
    height: auto;
    max-height: 100%;
    overflow-y: auto;
}

ModelScreen TabbedContent,
ModelScreen TabPane,
.hierarchy-message-full,
.agent-tools,
.agent-tool,
.coordination-details,
.coordination-actions,
.events {
    height: auto;
}

ModelScreen .model-advanced {
    margin-top: 1;
    border: none;
}

ModelScreen .model-advanced > CollapsibleTitle,
ModelScreen .model-advanced {
    padding: 0;
    background: transparent;
}

ModelScreen .model-yaml-editor {
    height: 12;
    margin-top: 1;
    border: round $border;
}

ModelScreen .model-yaml-editor.yaml-valid {
    border: round $success;
}

ModelScreen .model-yaml-editor.yaml-invalid {
    border: round $error;
}

ModelScreen .model-yaml-error {
    max-height: 6;
    text-wrap: wrap;
    overflow-x: hidden;
    overflow-y: auto;
}

ModelScreen Input,
ModelScreen Select,
ModelScreen SelectCurrent {
    height: 1;
    border: none;
}

ModelScreen Input,
ModelScreen SelectCurrent {
    padding: 0 1;
}

.model-field-label,
.settings-actions {
    height: 2;
    padding-top: 1;
}

.model-field-label-text,
.model-field-help-bracket,
.model-field-help-mark,
.edit-counts,
.settings-actions Button {
    width: auto;
    height: 1;
}

.model-field-label-text,
#messages-controls Button,
.edit-counts {
    margin-right: 1;
}

.model-field-help-mark,
.agent-tool-title {
    color: $accent;
}

.settings-title,
#information-title,
#coordination-title,
.agent-tools-title {
    height: 2;
    text-style: bold;
    color: $accent;
}

.settings-actions {
    align-horizontal: right;
}

.settings-actions Button {
    min-width: 10;
    padding: 0 1;
    border: none;
    margin-left: 1;
}

#information,
#coordination-dialog {
    width: 90%;
    height: 85%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#coordination-tabs,
#coordination-messages-tab,
#coordination-subagents-tab,
#messages-dialog,
#information-body,
#status-tabs,
#status-summary-tab,
#status-config-tab,
#agents-tabs {
    height: 1fr;
}

#messages-header,
#welcome-config-values,
#welcome-tip,
#prompt {
    height: 3;
}

#messages-controls {
    height: 1;
    margin-top: 1;
}

#messages-controls Button,
.coordination-navigation Button {
    width: 9;
    min-width: 9;
    height: 1;
    padding: 0 1;
    border: none;
}

#messages-title,
#messages-footer,
#coordination-subagents-summary,
.hierarchy-message-route,
.tool-call-preview,
.agent-tool-preview,
.edit-title,
.hierarchy-message-preview,
#welcome-workspace,
.coordination-summary,
.coordination-action-preview,
.coordination-page {
    height: 1;
    overflow: hidden hidden;
    text-overflow: ellipsis;
}

#messages-title {
    width: 100%;
    text-style: bold;
    color: $accent;
}

#messages-footer,
#coordination-subagents-summary,
#hotlist-exit-hint {
    color: $text-muted;
    text-style: italic;
}

#messages-body,
.agent-details {
    height: 1fr;
    padding: 0 1;
}

#messages-empty,
#status-config-readonly,
.event-expand-hint,
.edit-hint {
    height: 1;
    color: $text-muted;
    text-style: italic;
}

.hierarchy-message,
.agent-tool-details,
.tool-call-details,
.command-source,
.command-output,
.tool-json,
.tool-output-markdown {
    height: auto;
    padding: 0 1;
}

.hierarchy-message {
    margin-bottom: 1;
    background: $panel;
}

.hierarchy-message-header,
#welcome-workspace-label {
    height: 1;
}

.hierarchy-message-time {
    width: auto;
    margin-left: 1;
}

.hierarchy-message-preview,
.tool-json-title {
    color: $text-muted;
}

#coordination-subagents-tree {
    margin-top: 1;
    padding: 0 1;
    background: $surface;
}

#status-config-yaml,
#coordination-subagents-tree {
    height: 1fr;
    border: round $accent;
}

.agent-tools-title {
    padding-top: 1;
}

.agent-tools-error,
ModelScreen .model-yaml-error {
    height: auto;
    color: $error;
}

.agent-tools-empty,
.agent-tools-loading,
.hierarchy-message-time,
ModelScreen .model-advanced > CollapsibleTitle,
.activity,
.tool-message {
    height: 1;
    color: $text-muted;
}

#conversation {
    height: 1fr;
    padding: 1 2;
    overflow-y: scroll;
    scrollbar-size-vertical: 1;
    scrollbar-color: $scrollbar;
    scrollbar-color-hover: $scrollbar-hover;
    scrollbar-color-active: $scrollbar-active;
    scrollbar-background: $scrollbar-background;
}

#welcome,
.turn,
.message-card,
.event-card {
    height: auto;
    margin-bottom: 0;
}

#welcome-top {
    height: 8;
}

#welcome-logo {
    height: 8;
    padding: 0 3;
    border: round $border;
    color: $text;
    align: center middle;
}

#welcome-logo-stack {
    width: 100%;
    height: 5;
}

#welcome-logo-art {
    height: 4;
    content-align: center middle;
}

#welcome-version {
    height: 1;
    overflow: hidden hidden;
}

#welcome-config {
    height: 8;
    padding: 0 2;
    border: round $border;
    color: $text;
}

#welcome-workspace-row {
    width: 100%;
    margin-top: 1;
}

#welcome-workspace-row.workspace-inline {
    layout: horizontal;
    height: 1;
}

#welcome-workspace-row.workspace-stacked {
    layout: vertical;
    height: 2;
}

#welcome-workspace-row.workspace-inline > #welcome-workspace-label {
    width: 11;
}

#welcome-workspace-row.workspace-inline > #welcome-workspace {
    content-align: left middle;
}

#welcome-workspace-row.workspace-stacked > #welcome-workspace-label,
#welcome-workspace-row.workspace-stacked > #welcome-workspace {
    width: 100%;
}

#welcome-tip {
    padding: 0 2;
    border: round $border;
    color: $text-muted;
    content-align: left middle;
}

.turn-end-marker {
    height: 0;
}

.message-card {
    padding: 0 2;
}

.message-card.user {
    margin-top: 1;
    margin-bottom: 0;
    background: $primary-background;
    border-left: thick $primary;
}

.message-card.assistant {
    margin-top: 1;
    background: $secondary-background;
    border-left: thick $secondary;
}

.message-role,
.agent-tool-detail-title {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

.message-body,
.event-summary,
.queued-message-body {
    height: auto;
    background: transparent;
}

.events,
.activity {
    margin: 0;
    padding-left: 1;
    border-left: thick $warning-muted;
    background: $panel;
}

.events.has-events,
.activity.activity-after-user {
    margin-top: 1;
}

.event-card {
    padding: 0;
    background: $surface;
    color: $text;
}

CoordinationCard:focus,
AgentToolCard:focus,
HierarchyMessageCard:focus {
    outline: solid $accent;
}

CoordinationCard > .event-expand-hint,
AgentToolCard > .event-expand-hint {
    dock: none;
    width: 100%;
    padding: 0 1;
    content-align: left middle;
    overflow: hidden hidden;
    text-overflow: ellipsis;
}

.event-card-done {
    display: none;
    dock: right;
    width: 2;
    height: 100%;
    content-align: right bottom;
    color: $primary;
}

.event-card.summary-done > .event-card-done,
.activity.done > .activity-done-mark {
    display: block;
}

.exception-traceback {
    height: auto;
    margin: 0 1;
    border: round $border;
    background: $surface;
}

.exception-card > .event-expand-hint {
    dock: none;
    width: 100%;
}

.event-expand-hint,
.edit-hint {
    width: 18;
}

.event-expand-hint {
    dock: right;
}

.tool-call-title,
.edit-group-title,
.agent-tool-title,
.tool-json-title {
    height: 1;
    padding: 0 1;
    text-style: bold;
}

.tool-call-summary,
.agent-tool-summary,
.edit-header,
.edit-outcome,
.command-compact,
.coordination-navigation {
    height: 1;
    padding: 0 1;
}

.tool-call-state,
.agent-tool-state {
    width: 4;
    color: $primary;
}

.coordination-summary {
    padding: 0 1;
    text-style: bold;
    color: $accent;
}

.coordination-recent {
    height: 2;
    padding: 0 1;
}

.coordination-needs-attention > .coordination-summary,
.agent-tool-failed > .agent-tool-title,
.agent-tool-failed .agent-tool-state {
    color: $error;
    text-style: bold;
}

.coordination-actions {
    margin: 0 1;
    padding-left: 1;
    border-left: solid $accent-muted;
}

.coordination-navigation {
    margin: 1 0;
}

.coordination-page {
    content-align: center middle;
    color: $text-muted;
}

.agent-tool-details {
    margin: 0 1;
    border-left: thick $accent-muted;
}

.agent-tool-task,
.agent-tool-result {
    height: auto;
    margin-bottom: 1;
}

.tool-json-pane {
    height: auto;
    margin: 0 1 0 0;
    border: round $border;
}

.tool-output-pane {
    margin: 0 0 0 1;
}

.tool-json {
    background: $surface;
}

.tool-output-markdown {
    background: transparent;
}

.edit-diff {
    margin-left: 2;
    border: round $border;
    background: $surface;
}

.command-compact-state,
.tool-message-mark,
.activity-spinner {
    width: 3;
    color: $primary;
}

RunCommandCard > .activity {
    margin: 0;
    padding-left: 1;
    border-left: none;
    background: $surface;
}

RunCommandCard.command-expanded {
    border: round $border;
}

RunCommandCard.command-expanded > .event-expand-hint {
    dock: bottom;
    width: 100%;
    padding-right: 1;
}

.hidden {
    display: none;
}

#prompt {
    min-height: 3;
    margin: 0 1;
    border: tall $border-blurred;
    background: $surface;
}

#queued-messages {
    height: auto;
    max-height: 10;
    margin: 0 1;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

.queued-message {
    height: auto;
    min-height: 2;
    padding: 0 2;
    border-left: thick $border;
    background: $panel;
    color: $text-muted;
    opacity: 60%;
}

.queued-message-label {
    height: 1;
    text-style: italic;
}

.queued-message.delivery-failed {
    border-left: thick $error-muted;
    opacity: 80%;
}

#prompt:focus {
    border: tall $border;
}

.tool-message {
    margin: 1 2 0 2;
}

.activity-done-mark {
    display: none;
    width: 1;
    color: $primary;
    content-align: right bottom;
}

#hotlist-exit-hint,
#messages-footer,
.hierarchy-message-time,
#welcome-version,
#welcome-workspace-row.workspace-stacked > #welcome-workspace,
.exception-card > .event-expand-hint,
.event-expand-hint,
.edit-hint,
.activity.done > .activity-text {
    content-align: right middle;
}

#status {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text;
}
