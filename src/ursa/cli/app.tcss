HotlistScreen {
    align: center bottom;
    background: transparent;
}

#hotlist {
    width: 100%;
    height: 65%;
    min-height: 10;
    max-height: 16;
    margin-bottom: 4;
    padding: 0 1 1 1;
    border: round $accent;
    background: $surface;
}

#hotlist-header {
    width: 100%;
    height: 1;
}

#hotlist-title {
    width: 1fr;
}

#hotlist-exit-hint {
    width: auto;
    content-align: right middle;
    color: #91a1af;
    text-style: italic;
}

#hotlist-query {
    margin-bottom: 0;
}

#hotlist-options {
    height: 1fr;
    min-height: 3;
}

InformationScreen {
    align: center middle;
    background: #0008;
}

#information {
    width: 90%;
    height: 85%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#information-title {
    height: 2;
    text-style: bold;
    color: $accent;
}

#information-body {
    height: 1fr;
}

#agents-tabs {
    height: 1fr;
}

.agent-details {
    height: 1fr;
    padding: 0 1;
}

.agent-tools-title {
    height: 2;
    padding-top: 1;
    text-style: bold;
    color: $accent;
}

.agent-tool {
    height: auto;
}

.agent-tools-error {
    height: auto;
    color: $error;
}

.agent-tools-empty {
    height: 1;
    color: $text-muted;
}

Screen {
    layout: vertical;
    background: #101317;
}

#conversation {
    height: 1fr;
    padding: 1 2;
    overflow-y: scroll;
    scrollbar-size-vertical: 1;
    scrollbar-color: #55606d;
    scrollbar-color-hover: #718091;
    scrollbar-color-active: #8797a8;
    scrollbar-background: #0d1013;
}

#welcome {
    height: auto;
    margin-bottom: 1;
}

#welcome-top {
    height: 8;
}

#welcome-logo {
    width: 1fr;
    height: 8;
    padding: 0 3;
    border: round #61778b;
    color: #d5dbe0;
    align: center middle;
}

#welcome-logo-stack {
    width: 100%;
    height: 5;
}

#welcome-logo-art {
    height: 4;
    content-align: center middle;
}

#welcome-version {
    height: 1;
    content-align: right middle;
    overflow: hidden hidden;
}

#welcome-config {
    width: 1fr;
    height: 8;
    padding: 0 2;
    border: round #61778b;
    color: #bac6d0;
}

#welcome-workspace-row {
    width: 100%;
    margin-top: 1;
}

#welcome-workspace-row.workspace-inline {
    layout: horizontal;
    height: 1;
}

#welcome-workspace-row.workspace-stacked {
    layout: vertical;
    height: 2;
}

#welcome-workspace-row.workspace-inline > #welcome-workspace-label {
    width: 11;
}

#welcome-workspace-row.workspace-inline > #welcome-workspace {
    width: 1fr;
    content-align: left middle;
}

#welcome-workspace-row.workspace-stacked > #welcome-workspace-label,
#welcome-workspace-row.workspace-stacked > #welcome-workspace {
    width: 100%;
}

#welcome-workspace-row.workspace-stacked > #welcome-workspace {
    content-align: right middle;
}

#welcome-workspace-label {
    height: 1;
}

#welcome-workspace {
    height: 1;
    overflow: hidden hidden;
    text-overflow: ellipsis;
}

#welcome-config-values {
    height: 3;
}

#welcome-tip {
    height: 3;
    padding: 0 2;
    border: round #465868;
    color: #91a1af;
    content-align: left middle;
}

.turn {
    height: auto;
    margin-bottom: 0;
}

.turn-end-marker {
    height: 0;
}

.message-card {
    height: auto;
    padding: 0 2;
    margin-bottom: 0;
}

.message-card.user {
    margin-bottom: 1;
    background: #1a222a;
    border-left: thick #5c7894;
}

.message-card.assistant {
    margin-top: 1;
    background: #171d20;
    border-left: thick #5e7d68;
}

.message-role {
    height: 1;
    color: #7f91a3;
    text-style: bold;
}

.message-body {
    height: auto;
    background: transparent;
}

.events {
    height: auto;
    margin: 0;
    padding-left: 1;
    border-left: thick #71684f;
    background: #131719;
}

.event-card {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: #14191d;
    color: #aab4bd;
}

.event-summary,
.transcript {
    height: auto;
    background: transparent;
}

.event-card-done {
    display: none;
    dock: right;
    width: 2;
    height: 100%;
    content-align: right bottom;
    color: #7fa6ca;
}

.event-card.summary-done > .event-card-done {
    display: block;
}

.event-expand-hint {
    width: 100%;
    height: 1;
    content-align: right middle;
    color: #91a1af;
    text-style: italic;
}

.command-source,
.command-output {
    height: auto;
    padding: 0 1;
}

.command-compact {
    height: 1;
    padding: 0 1;
}

.command-compact-state {
    width: 3;
    color: #7fa6ca;
}

.command-compact-text {
    width: 1fr;
}

RunCommandCard > .activity {
    margin-left: 1;
}

.transcript {
    margin: 0;
    padding: 1;
    border-left: thick #71684f;
    background: #111519;
}

.hidden {
    display: none;
}

#prompt {
    height: 3;
    min-height: 3;
    margin: 0 1;
    border: tall #425364;
    background: #151b20;
}

#prompt:focus {
    border: tall #6c8aa6;
}

.activity {
    height: 1;
    margin: 0;
    padding-left: 1;
    border-left: thick #71684f;
    background: #131719;
    color: #91a1af;
}

.activity-spinner {
    width: 3;
    color: #7fa6ca;
}

.activity-text {
    width: 1fr;
}

.activity-done-mark {
    display: none;
    width: 1;
    color: #7fa6ca;
    content-align: right bottom;
}

.activity.done > .activity-text {
    content-align: right middle;
}

.activity.done > .activity-done-mark {
    display: block;
}

#status {
    height: 1;
    padding: 0 2;
    background: #202830;
    color: #b5c1cb;
}
