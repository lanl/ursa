Screen {
    background: $background;
}

#setup-shell {
    width: 100%;
    height: 1fr;
}

#progress-panel {
    width: 40;
    height: 100%;
    padding: 2 2;
    border-right: solid $accent;
    background: $surface;
}

#setup-banner {
    width: 100%;
    height: 4;
    color: $accent;
    text-style: bold;
    content-align: center middle;
}

#setup-progress {
    width: 100%;
    height: auto;
    margin-top: 2;
    color: $text-muted;
}

#setup-main,
#setup-pages,
.setup-page {
    width: 100%;
    height: 100%;
}

#setup-main {
    width: 1fr;
}

.setup-page {
    padding: 1 2;
    overflow-x: hidden;
}

.page-title {
    height: 3;
    color: $accent;
    text-style: bold;
}

.page-copy {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    color: $text-muted;
}

.path-box,
.review-box {
    width: 100%;
    height: auto;
    margin: 1 0;
    padding: 1 2;
    border: round $border;
    background: $surface;
}

Label {
    height: 2;
    padding-top: 1;
}

Input,
Select,
SelectCurrent {
    width: 100%;
}

Checkbox {
    margin-top: 1;
}

.setup-actions {
    width: 100%;
    height: 4;
    margin-top: 1;
    align-horizontal: right;
    padding-top: 1;
}

.setup-actions Button,
.manage-actions Button {
    min-width: 14;
    margin-left: 1;
}

.manage-actions {
    width: 100%;
    height: 4;
    padding-top: 1;
}

#providers-tabs {
    width: 100%;
    height: 12;
    margin-bottom: 1;
}

.provider-summary {
    width: 100%;
    height: auto;
    padding: 1 2;
}

.model-validation {
    width: 100%;
    height: 3;
    padding-top: 1;
}

.model-validation-status {
    width: 1fr;
    height: 2;
    color: $text-muted;
}

.model-validation-status.success {
    color: $success;
}

.model-validation-status.error {
    color: $error;
}

.setup-model-advanced,
.setup-mcp-advanced {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
}

.setup-model-advanced > CollapsibleTitle,
.setup-mcp-advanced > CollapsibleTitle {
    height: 1;
    padding: 0;
    color: $text-muted;
    background: transparent;
}

.setup-model-yaml-editor,
.setup-mcp-yaml-editor {
    height: 12;
    margin: 0;
    border: round $border;
}

.setup-model-yaml-editor.yaml-valid,
.setup-mcp-yaml-editor.yaml-valid {
    border: round $success;
}

.setup-model-yaml-editor.yaml-invalid,
.setup-mcp-yaml-editor.yaml-invalid {
    border: round $error;
}

.setup-model-yaml-error,
.setup-mcp-yaml-error {
    width: 1fr;
    height: auto;
    max-height: 6;
    color: $error;
    text-wrap: wrap;
    overflow-x: hidden;
    overflow-y: auto;
}

#mcp-token-row {
    width: 100%;
    height: auto;
}

#mcp-remote-fields,
#mcp-local-fields {
    height: auto;
}

#mcp-token-selector {
    width: 100%;
    height: auto;
}

#mcp-token-row.has-token #mcp-token-selector {
    width: 22;
}

#mcp-auth-fields {
    width: 1fr;
    height: auto;
    margin-left: 1;
}

#mcp-token-row.selecting #mcp-token-selector {
    width: 100%;
}

#mcp-token-row.selecting #mcp-auth-fields {
    display: none;
}

.api-key-entry {
    width: 100%;
    height: auto;
}

.api-key-row {
    width: 100%;
    height: 3;
}

.api-key-row Input {
    width: 1fr;
}

.api-key-row Checkbox {
    width: auto;
    margin: 0 0 0 1;
}

#provider-url-row {
    width: 100%;
    height: 3;
}

#provider-url-row #provider-url {
    width: 100%;
}

#provider-url-row.custom-url #provider-url {
    width: 22;
}

#provider-url-row #provider-url-custom {
    width: 1fr;
    margin-left: 1;
}

#provider-url-row.selecting #provider-url {
    width: 100%;
}

#provider-url-row.selecting #provider-url-custom {
    display: none;
}

.form-message {
    width: 100%;
    min-height: 2;
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

.form-message.error {
    color: $error;
}

.form-message.success {
    color: $success;
}

.setup-page > * {
    margin-right: 1;
}

.hidden {
    display: none;
}
