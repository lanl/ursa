Screen {
    background: $background;
}

#setup-shell {
    width: 100%;
    height: 1fr;
}

#progress-panel {
    width: 40;
    height: 100%;
    padding: 2 2;
    border-right: solid $accent;
    background: $surface;
}

#setup-banner {
    width: 100%;
    height: 4;
    color: $accent;
    text-style: bold;
    content-align: center middle;
}

#setup-progress {
    width: 100%;
    height: auto;
    margin-top: 2;
    color: $text-muted;
}

#setup-main,
#setup-pages,
.setup-page {
    width: 100%;
    height: 100%;
}

#setup-main {
    width: 1fr;
}

.setup-page {
    padding: 1 2;
    overflow-x: hidden;
}

.page-title {
    height: 3;
    color: $accent;
    text-style: bold;
}

.page-copy {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    color: $text-muted;
}

.path-box,
.review-box {
    width: 100%;
    height: auto;
    margin: 1 0;
    padding: 1 2;
    border: round $border;
    background: $surface;
}

.review-details {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
    border: none;
    background: transparent;
}

.review-details > CollapsibleTitle {
    height: 1;
    padding: 0;
    color: $text-muted;
    background: transparent;
}

.review-readonly {
    width: 100%;
    height: 1;
    color: $text-muted;
}

#review-config-yaml,
#review-doctor-output {
    width: 100%;
    height: 16;
    border: round $border;
}

#review-page .setup-actions Button {
    min-width: 5;
    padding: 0;
}

Label {
    height: 2;
    padding-top: 1;
}

Input,
Select,
SelectCurrent {
    width: 100%;
}

.setup-actions {
    width: 100%;
    height: 4;
    margin-top: 1;
    align-horizontal: right;
    padding-top: 1;
}

.setup-actions Button,
.manage-actions Button {
    min-width: 14;
    margin-left: 1;
}

.manage-actions {
    width: 100%;
    height: 4;
    padding-top: 1;
}

#providers-tabs,
#mcps-tabs {
    width: 100%;
    height: 12;
    margin-bottom: 1;
}

ModelEditor {
    width: 100%;
    height: auto;
}

ModelEditor .settings-dialog {
    width: 100%;
    height: auto;
    padding: 0;
    border: none;
    background: transparent;
}

ModelEditor .settings-title {
    display: none;
}

ModelEditor TabbedContent,
ModelEditor TabPane {
    height: auto;
}

ModelEditor .settings-actions {
    width: 100%;
    height: 4;
    padding-top: 1;
    align-horizontal: right;
}

ModelEditor .settings-actions Button {
    min-width: 14;
    margin-left: 1;
}

#mcp-remote-fields,
#mcp-local-fields {
    height: auto;
}

.api-key-entry {
    width: 100%;
    height: 5;
}

.credential-label-row {
    width: 100%;
    height: 2;
}

.credential-row {
    width: 100%;
    height: 3;
}

.credential-source-label {
    width: 22;
}

.credential-value-label {
    width: 1fr;
    margin-left: 1;
}

.credential-source {
    width: 22;
}

.credential-value {
    width: 1fr;
    height: 3;
    margin-left: 1;
}

.api-key-row {
    height: 3;
}

.api-key-row Input {
    width: 1fr;
}

.api-key-row Checkbox {
    width: auto;
    margin: 0 0 0 1;
}

#provider-url-row {
    width: 100%;
    height: 3;
}

#provider-url-row #provider-url {
    width: 100%;
}

#provider-url-row.custom-url #provider-url {
    width: 40;
}

#provider-url-row #provider-url-custom {
    width: 1fr;
    margin-left: 1;
}

.form-message {
    width: 100%;
    min-height: 2;
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

.form-message.error {
    color: $error;
}

.setup-page > * {
    margin-right: 1;
}

.hidden {
    display: none;
}
